# Copy to .env for local development. Never commit the real file.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DATABASE_URL unset to use SQLite locally.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Get a free key at https://openrouteservice.org/dev/#/signup
# Without it the API falls back to estimated straight-line distances.
ORS_API_KEY=
ORS_PROFILE=driving-hgv
