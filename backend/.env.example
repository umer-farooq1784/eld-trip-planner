# Copy to .env for local development. Never commit the real file.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DATABASE_URL unset to use SQLite locally.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Sign up at https://account.heigit.org, then create a free token under
# https://openrouteservice.org/dev/#/home -> TOKENS.
# Without a key the API falls back to estimated straight-line distances.
ORS_API_KEY=
ORS_PROFILE=driving-hgv
# api.openrouteservice.org was shut off 24 Aug 2026; these are the HeiGIT URLs.
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_GEOCODE_URL=https://api.heigit.org/pelias/v1
